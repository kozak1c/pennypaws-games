---
// A paperback on white paper: the cover with pages peeking out, what is in it, and where to buy it.
import { Image } from 'astro:assets';
import type { Book } from '../data/catalog';
interface Props {
  book: Book;
  heading?: 'h2' | 'h3';
}
const { book, heading: Heading = 'h3' } = Astro.props;
---

<article class="card bookcard grid grid-rows-[auto_auto_1fr_auto_auto_auto] gap-3 p-[clamp(1rem,2.4vw,1.75rem)]">
  <div class="bookshow mb-2">
    <span class="cover"><Image src={book.cover.src} alt={book.cover.alt} width={400} /></span>
    {book.peek.map((s, i) => (
      <span class:list={['sheet', i > 0 && `sheet--${i + 1}`]}><Image src={s.src} alt={s.alt} width={300} /></span>
    ))}
  </div>
  <Heading class="text-[clamp(1.375rem,1.1rem+1vw,1.75rem)]">{book.name}</Heading>
  <p class="text-[1rem] font-bold text-navy-soft">{book.blurb}</p>
  <ul class="flex flex-wrap gap-2">
    {book.facts.map((fact) => <li class="chip">{fact}</li>)}
  </ul>
  <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-3">
    <span class="sticker sticker--plain">{book.price} paperback</span>
    <a class="candy candy--small candy--yellow" href={book.amazon}>Buy on Amazon<span class="sr-only">: {book.name}</span></a>
  </div>
  <a class="inline-flex min-h-11 items-center justify-self-start text-[1rem] font-extrabold underline decoration-2 underline-offset-4" href={`/printables/${book.printable}/`}>
    Or print it at home today
  </a>
</article>
