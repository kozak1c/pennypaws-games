---
// A paperback on white paper: the cover with pages peeking out, what is in it, and where to buy it.
import { Image } from 'astro:assets';
import type { Book } from '../data/catalog';
interface Props {
  book: Book;
  heading?: 'h2' | 'h3';
  /** On a phone, leave out the blurb and the facts (the home page; the Books page has them). */
  compact?: boolean;
}
const { book, heading: Heading = 'h3', compact = false } = Astro.props;
---

<article class:list={['card bookcard grid gap-3 p-[clamp(1rem,2.4vw,1.75rem)] desk:grid-rows-[auto_auto_1fr_auto_auto_auto]', compact && 'bookcard--compact']}>
  <div class="bookshow bookcard__show mb-2">
    <span class="cover"><Image src={book.cover.src} alt={book.cover.alt} width={400} /></span>
    {book.peek.map((s, i) => (
      <span class:list={['sheet', i > 0 && `sheet--${i + 1}`]}><Image src={s.src} alt={s.alt} width={300} /></span>
    ))}
  </div>
  <Heading class="bookcard__name text-[clamp(1.375rem,1.1rem+1vw,1.75rem)]">{book.name}</Heading>
  <p class:list={['bookcard__blurb text-[1rem] font-bold text-navy-soft', compact && 'max-desk:hidden']}>{book.blurb}</p>
  <ul class:list={['bookcard__facts flex flex-wrap gap-2', compact && 'max-desk:hidden']}>
    {book.facts.map((fact) => <li class="chip">{fact}</li>)}
  </ul>
  <div class="bookcard__buy mt-1 flex flex-wrap items-center gap-x-4 gap-y-3 max-desk:flex-col max-desk:items-start">
    <span class="sticker sticker--plain">{book.price} paperback</span>
    <a class="candy candy--small candy--yellow" href={book.amazon}>Buy on Amazon<span class="sr-only">: {book.name}</span></a>
  </div>
  <a class="bookcard__print inline-flex min-h-11 items-center justify-self-start text-[1rem] font-extrabold underline decoration-2 underline-offset-4" href={`/printables/${book.printable}/`}>
    Or print it at home today
  </a>
</article>
