---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Shape from '../../components/Shape.astro';
import { books, printables, squishyBop as game, type Printable } from '../../data/catalog';

export function getStaticPaths() {
  return printables.map((item) => ({ params: { id: item.id }, props: { item } }));
}

interface Props {
  item: Printable;
}
const { item } = Astro.props;
const paperback = books.find((b) => b.id === item.book);
const squishy = item.id.includes('squish');
---

<Base title={`${item.name} | Penny Paws Games`} description={item.hook} section="printables">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-[clamp(0.75rem,1.5vw,1.125rem)] pt-[clamp(0.875rem,2vw,1.5rem)] pb-14">
    <a class="crumb" href="/printables/"><Shape name="back" />All printables</a>

    <section class="tray tray--paper" aria-labelledby="h-item">
      <div class="grid items-center gap-[clamp(1.25rem,3vw,2.5rem)] desk:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
        <span class="card__art rounded-[clamp(1rem,2vw,1.5rem)] shadow-[0_0.75rem_1.5rem_rgb(30_37_80/0.2)]">
          <Image class="card__blur" src={item.cover.src} alt="" width={120} aria-hidden="true" loading="eager" />
          <Image src={item.cover.src} alt={item.cover.alt} width={900} widths={[640, 900]} sizes="(min-width: 60rem) 36rem, 92vw" loading="eager" />
        </span>
        <div class="grid justify-items-start gap-4">
          <h1 class="text-[clamp(2rem,1.4rem+2.6vw,3.25rem)]" id="h-item">{item.name}</h1>
          <p class="tray__line">{item.hook}</p>
          <ul class="flex flex-wrap gap-2">
            {item.facts.map((fact) => <li class="chip">{fact}</li>)}
          </ul>
          <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-3">
            <span class="sticker sticker--plain text-[1.25rem]">{item.price}</span>
            <a class="candy candy--red" href={item.etsy}>Buy on Etsy<span class="sr-only">: {item.name}</span></a>
          </div>
          <p class="text-[0.9375rem] font-bold text-navy-soft">A digital download to print at home, not a printed book. One payment, and you can print it as often as you like.</p>
        </div>
      </div>
    </section>

    {item.pair && (
      <section class="tray tray--heart" aria-labelledby="h-pair">
        <h2 class="tray__title text-[clamp(1.625rem,1.2rem+1.8vw,2.5rem)]" id="h-pair">Every page comes with its colored example</h2>
        <div class="grid items-end gap-[clamp(1.25rem,3vw,2.5rem)] desk:grid-cols-2">
          <figure class="grid gap-3">
            <div class="grid grid-cols-2 gap-3">
              <span class="sheet"><Image src={item.pair.blank.src} alt={item.pair.blank.alt} width={420} /></span>
              <span class="sheet"><Image src={item.pair.colored.src} alt={item.pair.colored.alt} width={420} /></span>
            </div>
            <figcaption class="text-[1.1875rem] leading-tight font-extrabold">{item.pair.caption}</figcaption>
          </figure>
          {item.made && (
            <figure class="grid gap-3">
              <Image class="w-full rounded-[1rem] shadow-[0_0.75rem_1.5rem_rgb(30_37_80/0.3)]" src={item.made.pic.src} alt={item.made.pic.alt} width={720} />
              <figcaption class="text-[1.1875rem] leading-tight font-extrabold">{item.made.caption}</figcaption>
            </figure>
          )}
        </div>
      </section>
    )}

    {item.sheets.length > 0 && (
      <section class="tray tray--paper" aria-labelledby="h-pages">
        <h2 class="tray__title text-[clamp(1.625rem,1.2rem+1.8vw,2.5rem)]" id="h-pages">A look at the pages</h2>
        <section class="pages" aria-label="Sample pages" tabindex="0">
          {item.sheets.map((s) => (
            <span class="sheet"><Image src={s.src} alt={s.alt} width={420} /></span>
          ))}
        </section>
      </section>
    )}

    {item.get && (
      <section class="tray tray--paper" aria-labelledby="h-inside">
        <div class="grid gap-x-12 gap-y-8 desk:grid-cols-2">
          {item.inside && (
            <div class="grid content-start gap-4">
              <h2 class="tray__title text-[clamp(1.625rem,1.2rem+1.8vw,2.5rem)]">What’s inside</h2>
              <ul class="ticks">
                {item.inside.map((row) => (
                  <li><Shape name="heart" /><span><b>{row.lead}:</b> {row.rest}</span></li>
                ))}
              </ul>
            </div>
          )}
          <div class="grid content-start gap-4">
            <h2 class="tray__title text-[clamp(1.625rem,1.2rem+1.8vw,2.5rem)]" id="h-inside">What you get</h2>
            <ul class="ticks">
              {item.get.map((row) => (
                <li><Shape name="check" /><span>{row}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <a class="candy candy--red justify-self-start" href={item.etsy}>Buy on Etsy, {item.price}</a>
      </section>
    )}

    {(paperback || squishy) && (
      <section class="tray tray--sun" aria-labelledby="h-also">
        <h2 class="tray__title text-[clamp(1.625rem,1.2rem+1.8vw,2.5rem)]" id="h-also">{paperback && !squishy ? 'Rather have the book?' : 'More squishy fun'}</h2>
        <div class:list={['rail', paperback && squishy ? 'rail--two' : 'rail--three']}>
          {paperback && (
            <Card href="/books/" name={paperback.name} line={paperback.line} price={paperback.price} cover={paperback.cover} kind="Paperback" button="See the paperback" tone="yellow" />
          )}
          {squishy && (
            <a class="card" href="/squishy-bop/">
              <span class="card__art">
                <Image class="card__blur" src={game.feature.src} alt="" width={120} aria-hidden="true" />
                <Image src={game.feature.src} alt={game.feature.alt} width={640} widths={[360, 640]} sizes="(min-width: 60rem) 18rem, 72vw" />
              </span>
              <span class="card__name">{game.name}</span>
              <span class="card__line">The same squishy friends in a game for your phone.</span>
              <span class="candy candy--small">Meet the game</span>
            </a>
          )}
        </div>
      </section>
    )}
  </div>
</Base>
