---
// The page for a game that is not out yet. It says "Coming soon" where a store button will go.
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import GameShots from '../../components/GameShots.astro';
import Shape from '../../components/Shape.astro';
import { allGames, soonGames, type SoonGame } from '../../data/games';

export function getStaticPaths() {
  return soonGames.map((game) => ({ params: { game: game.id }, props: { game } }));
}

interface Props {
  game: SoonGame;
}
const { game } = Astro.props;
const others = allGames.filter((g) => g.id !== game.id);
---

<Base title={`${game.name} | Penny Paws Games`} description={game.tagline} section="games">
  <div class="wrap grid grid-cols-[minmax(0,1fr)] gap-[clamp(0.75rem,1.5vw,1.125rem)] pt-[clamp(0.875rem,2vw,1.5rem)] pb-14">
    <a class="crumb" href="/games/"><Shape name="back" />All games</a>

    <!-- The game's own colours are used on its own page only. -->
    <section class:list={['tray', `tray--${game.tone}`]} aria-labelledby="h-game">
      <div class="grid items-center gap-[clamp(1.25rem,3vw,2.5rem)] desk:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
        <Image
          class="w-full rounded-[clamp(1rem,2vw,1.5rem)] shadow-[0_1rem_2rem_rgb(15_20_51/0.4)]"
          src={game.feature.src}
          alt={game.feature.alt}
          widths={[640, 1024]}
          sizes="(min-width: 60rem) 38rem, 92vw"
          loading="eager"
        />
        <div class="grid justify-items-start gap-4">
          <div class="flex items-center gap-4">
            <Image class="w-[5.25rem] rounded-[22%] shadow-[0_0.5rem_1rem_rgb(15_20_51/0.35)]" src={game.icon.src} alt="" width={192} loading="eager" />
            <div class="grid justify-items-start gap-1.5">
              <h1 class="text-[clamp(2.25rem,1.5rem+3vw,3.5rem)]" id="h-game">{game.name}</h1>
              <span class="chip chip--navy">{game.status}</span>
            </div>
          </div>
          <p class="tray__line">{game.tagline}</p>
        </div>
      </div>
    </section>

    <section class:list={['tray', `tray--${game.tone}`]} aria-labelledby="h-play">
      <h2 class="tray__title" id="h-play">See it played</h2>
      <GameShots name={game.name} played={game.played} />
    </section>

    <section class="tray tray--paper" aria-labelledby="h-about">
      <h2 class="tray__title" id="h-about">What it is</h2>
      <p class="max-w-[44rem] text-[clamp(1.125rem,1rem+0.5vw,1.3125rem)] font-bold">{game.pitch}</p>
      {game.audience && <p class="max-w-[44rem] text-[1.0625rem] font-bold text-navy-soft">{game.audience}</p>}
      <div class:list={['grid gap-x-10 gap-y-6', game.parts.length === 4 ? 'desk:grid-cols-2' : 'desk:grid-cols-3']}>
        {game.parts.map((part) => (
          <div class="grid content-start gap-2">
            <h3 class="text-[1.375rem]">{part.title}</h3>
            <p class="text-[1.0625rem] text-navy-soft">{part.text}</p>
          </div>
        ))}
      </div>
    </section>

    {game.grownUps.length > 0 && (
      <section class="tray tray--paper" aria-labelledby="h-grown">
        <h2 class="tray__title" id="h-grown"><Shape name="star" />For grown-ups</h2>
        <dl class="facts">
          {game.grownUps.map((fact) => (
            <div>
              <dt>{fact.term}</dt>
              <dd>{fact.text}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    <section class="tray" aria-labelledby="h-more">
      <h2 class="tray__title" id="h-more">More games</h2>
      <div class="rail rail--two">
        {others.map((other) => (
          <GameCard game={other} button={other.id === 'squishy-bop' ? 'Meet Squishy Bop!' : 'Take a look'} />
        ))}
      </div>
    </section>
  </div>
</Base>
